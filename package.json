{
  "name": "nexusdreamer",
  "version": "0.1.0",
  "description": "Local-first immutable AI image revision chain harness",
  "main": "dist/main/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:main:tsc\" \"npm:dev:electron\"",
    "dev:renderer": "vite --host 127.0.0.1",
    "dev:main:tsc": "tsc -p tsconfig.main.json --watch --preserveWatchOutput",
    "dev:electron": "wait-on dist/main/main.js http://127.0.0.1:5173 && electron .",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "setup": "node scripts/setup.mjs",
    "verify": "npm run build && node scripts/verify.mjs",
    "test": "vitest run",
    "package": "npm run build && electron-builder"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "electron": "^36.0.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.2",
    "vite": "^6.1.0",
    "vitest": "^3.0.8",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "dev.luminarylabs.nexusdreamer",
    "productName": "NexusDreamer",
    "files": ["dist/**/*", "data/**/*", "package.json"],
    "extraResources": [{"from":"data","to":"data"}],
    "directories": {"output":"release"}
  }
}
